{
  "project": "quantization-har",
  "seed": 42,
  "paths": {
    "raw_data": "data/raw",
    "processed_data": "data/processed",
    "models": "models",
    "results": "results"
  },
  "dataset": {
    "name": "UCI-HAR",
    "input_shape": [128, 9],
    "channel_order": [
      "total_acc_x",
      "total_acc_y",
      "total_acc_z",
      "body_gyro_x",
      "body_gyro_y",
      "body_gyro_z",
      "body_acc_x",
      "body_acc_y",
      "body_acc_z"
    ],
    "labels": [
      "WALKING",
      "WALKING_UPSTAIRS",
      "WALKING_DOWNSTAIRS",
      "SITTING",
      "STANDING",
      "LAYING"
    ],
    "validation_subjects": [27, 28, 29, 30],
    "split_policy": "official_test_subject_disjoint_validation_from_train",
    "normalization": "fit_on_train_only"
  },
  "model": {
    "architecture": "ResNetv1-6_1D_adapted_from_Figure_4",
    "filters": 32,
    "confirmed_against_paper": true,
    "paper_reference": "Novac et al. 2021, Figure 4 and Section 6.1.1"
  },
  "training": {
    "epochs": 300,
    "batch_size": 64,
    "learning_rate": 0.05,
    "momentum": 0.9,
    "weight_decay": 0.0005,
    "lr_decay_factor": 0.13,
    "lr_milestones": [100, 200, 250],
    "mixup_alpha": 0.2,
    "checkpoint_monitor": "val_accuracy"
  },
  "quantization": {
    "method": "PTQ_INT8",
    "calibration_sizes": [
      50,
      200,
      500
    ],
    "calibration_seeds": [
      11,
      22,
      33
    ],
    "selection_split": "train"
  },
  "evaluation": {
    "selection_split": "validation",
    "final_split": "test",
    "metrics": [
      "accuracy_pct",
      "macro_f1",
      "model_size_bytes"
    ]
  },
  "export_c": {
    "checkpoint": "models/baseline.keras",
    "metadata": "models/baseline_metadata.json",
    "preprocess": "data/processed/preprocess.json",
    "sanity_samples": "data/processed/sanity_samples.npz",
    "params_npz": "models/params_fp32.npz",
    "manifest": "models/params_manifest.json",
    "firmware_dir": "firmware",
    "values_per_line": 8,
    "float_format": "{:.9g}f"
  }
}
