    },
    {
      "id": "normalized-main", "from": "normalize", "to": "b1main",
      "label": "tín hiệu chuẩn hóa", "classification": "main path", "variant": "emphasis"
    },
    {
      "id": "normalized-shortcut", "from": "normalize", "to": "b1shortcut",
