    },
    {
      "id": "b1add", "type": "security", "label": "Add + ReLU",
      "sublabel": "main + projection", "tag": "x: 64×32",
      "stage": 2, "row": 1, "width": 160
    },
    {
      "id": "b2main", "type": "backend", "label": "Block 2 · main",
      "sublabel": "Conv3–ReLU–Conv3", "tag": "F(x): 64×32",
      "stage": 2, "row": 0, "width": 170
    },
    {
      "id": "b2identity", "type": "messagebus", "label": "Block 2 · identity",
      "sublabel": "truyền nguyên x", "tag": "0 tham số",
      "stage": 2, "row": 2, "width": 170
    },
    {
      "id": "fp32head", "type": "frontend", "label": "FP32 classifier",
      "sublabel": "Add–ReLU–GMP–Dense6", "tag": "argmax · 10.726 params",
