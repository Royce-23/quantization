      "labelAt": [540, 328]
    },
    {
      "id": "b2-features", "from": "b2main", "to": "fp32head",
      "label": "F₂(x)", "classification": "learned features", "variant": "emphasis", "route": "straight",
      "labelAt": [635, 110]
    },
    {
      "id": "b2-preserved", "from": "b2identity", "to": "fp32head",
      "label": "x", "classification": "identity", "variant": "dashed",
      "labelAt": [620, 335]
    },
    {
      "id": "checkpoint-calibration", "from": "fp32head", "to": "calibration",
      "label": "checkpoint FP32", "classification": "một checkpoint cố định", "variant": "security",
      "labelAt": [745, 214]
    },
    {
      "id": "calibrated-model", "from": "calibration", "to": "int8",
      "label": "scale + zero-point", "classification": "affine quantization", "variant": "security",
      "labelAt": [745, 328]
    },
    {
      "id": "fp32-baseline", "from": "fp32head", "to": "validation",
      "label": "baseline FP32", "classification": "reference", "variant": "dashed"
    },
    {
      "id": "int8-candidates", "from": "int8", "to": "validation",
      "label": "9 model INT8", "classification": "candidates", "variant": "emphasis"
    },
    {
      "id": "selected-test", "from": "validation", "to": "test",
      "label": "n=500 · 3 seed", "classification": "selected before test", "variant": "emphasis",
      "labelAt": [960, 328]
    }
  ],
  "cards": [
    {
