      "stage": 3, "row": 1, "width": 180
    },
    {
      "id": "int8", "type": "cloud", "label": "TFLite INT8",
      "sublabel": "scale + zero-point", "tag": "full-integer · 0 float",
      "stage": 3, "row": 2, "width": 180
    },
    {
      "id": "validation", "type": "security", "label": "Validation",
      "sublabel": "9 INT8 → chọn n=500", "tag": "test chưa được mở",
      "stage": 4, "row": 1, "width": 180
    },
    {
      "id": "test", "type": "external", "label": "Test & report",
      "sublabel": "accuracy · F1 · bytes · CM", "tag": "92,60% → 92,18%",
      "stage": 4, "row": 2, "width": 180
    }
  ],
  "flows": [
    {
      "id": "raw-window", "from": "sensor", "to": "normalize",
