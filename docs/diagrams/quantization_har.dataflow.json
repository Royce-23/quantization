    },
    {
      "id": "b1-features", "from": "b1main", "to": "b1add",
      "label": "đặc trưng mới", "classification": "F₁(x)", "variant": "emphasis"
    },
    {
      "id": "b1-preserved", "from": "b1shortcut", "to": "b1add",
      "label": "thông tin giữ lại", "classification": "projection", "variant": "dashed"
    },
    {
      "id": "b2-main-input", "from": "b1add", "to": "b2main",
      "label": "x", "classification": "main path", "variant": "emphasis",
      "labelAt": [350, 224]
    },
    {
      "id": "b2-identity-input", "from": "b1add", "to": "b2identity",
