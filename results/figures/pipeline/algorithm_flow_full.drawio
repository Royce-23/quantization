  <diagram name="Quantization HAR — Full pipeline" id="har-full-pipeline">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="3000" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
<mxCell id="title" value="QUANTIZATION HAR — TOÀN BỘ PIPELINE (DỮ LIỆU → PTQ → THUẬT TOÁN SUY LUẬN)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1700" height="40" as="geometry" /></mxCell>
<mxCell id="secA" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3fc;strokeColor=#9fb8e0;verticalAlign=top;fontSize=1;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1700" height="400" as="geometry" /></mxCell>
<mxCell id="labelA" value="A. DỮ LIỆU VÀ BASELINE FP32" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;align=left;fontColor=#2a4d8f;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="500" height="24" as="geometry" /></mxCell>
<mxCell id="a1" value="UCI-HAR&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;7352 train + 2947 test&lt;br&gt;128×9 cảm biến&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="230" height="90" as="geometry" /></mxCell>
<mxCell id="a2" value="Chia dữ liệu&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;train/validation/test&lt;br&gt;tách theo subject&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="230" height="90" as="geometry" /></mxCell>
<mxCell id="a3" value="Z-score&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;mean, std fit trên train&lt;br&gt;không rò rỉ test&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="110" width="230" height="90" as="geometry" /></mxCell>
<mxCell id="a4" value="ResNetv1-6 1D&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Conv/Pool + residual&lt;br&gt;10.726 tham số&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="110" width="230" height="90" as="geometry" /></mxCell>
<mxCell id="a5" value="Huấn luyện FP32&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;SGD, 300 epoch&lt;br&gt;chọn checkpoint tốt nhất&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="110" width="230" height="90" as="geometry" /></mxCell>
<mxCell id="a6" value="baseline.keras&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;FP32 checkpoint&lt;br&gt;92,60% test&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="110" width="230" height="90" as="geometry" /></mxCell>
<mxCell id="img_class_dist" value="Phân bố nhãn (class_distribution.png)" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;imageAspect=1;image=data:image/png,;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="50" y="215" width="230" height="150" as="geometry" /></mxCell>
<mxCell id="img_model_arch" value="Sơ đồ Keras (model_architecture.png)" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;imageAspect=1;image=data:image/png,;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="800" y="215" width="230" height="150" as="geometry" /></mxCell>
<mxCell id="img_train_curves" value="Đường cong huấn luyện (training_curves.png)" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;imageAspect=1;image=data:image/png,;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1050" y="215" width="230" height="150" as="geometry" /></mxCell>
<mxCell id="img_cm_fp32" value="Confusion matrix FP32 (confusion_matrix_fp32.png)" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;imageAspect=1;image=data:image/png,;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1300" y="215" width="230" height="150" as="geometry" /></mxCell>
<mxCell id="secB" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eafaf0;strokeColor=#8fcf9f;verticalAlign=top;fontSize=1;" vertex="1" parent="1"><mxGeometry x="30" y="480" width="1700" height="400" as="geometry" /></mxCell>
<mxCell id="labelB" value="B. PTQ INT8, ĐÁNH GIÁ VÀ BÁO CÁO" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;align=left;fontColor=#217a3c;" vertex="1" parent="1"><mxGeometry x="50" y="490" width="500" height="24" as="geometry" /></mxCell>
<mxCell id="b1" value="baseline.keras&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;đầu vào FP32 đã&lt;br&gt;chuẩn hoá&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f2dd;strokeColor=#6fbf84;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="530" width="230" height="90" as="geometry" /></mxCell>
<mxCell id="b2" value="Calibration từ train&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;n = 50/200/500&lt;br&gt;seed = 11/22/33&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f2dd;strokeColor=#6fbf84;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="530" width="230" height="90" as="geometry" /></mxCell>
<mxCell id="b3" value="Tìm scale &amp; zero-point&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;cho activation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f2dd;strokeColor=#6fbf84;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="530" width="230" height="90" as="geometry" /></mxCell>
<mxCell id="b4" value="TFLite PTQ&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;full-integer INT8&lt;br&gt;input/output = int8&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f2dd;strokeColor=#6fbf84;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="530" width="230" height="90" as="geometry" /></mxCell>
<mxCell id="b5" value="Validation&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;9 cấu hình INT8&lt;br&gt;chọn n = 500&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f2dd;strokeColor=#6fbf84;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="530" width="230" height="90" as="geometry" /></mxCell>
<mxCell id="b6" value="Test cuối&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;accuracy, macro-F1&lt;br&gt;dung lượng, confusion matrix&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f2dd;strokeColor=#6fbf84;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="530" width="230" height="90" as="geometry" /></mxCell>
<mxCell id="img_acc_cal" value="Accuracy theo calibration (accuracy_vs_calibration.png)" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;imageAspect=1;image=data:image/png,;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1050" y="635" width="230" height="150" as="geometry" /></mxCell>
<mxCell id="img_f1_cal" value="Macro-F1 theo calibration (macro_f1_vs_calibration.png)" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;imageAspect=1;image=data:image/png,;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1050" y="800" width="230" height="150" as="geometry" /></mxCell>
<mxCell id="img_size_cmp" value="So sánh dung lượng (model_size_comparison.png)" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;imageAspect=1;image=data:image/png,;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1300" y="635" width="230" height="150" as="geometry" /></mxCell>
<mxCell id="img_cm_int8" value="Confusion matrix INT8 (confusion_matrix_test.png)" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;imageAspect=1;image=data:image/png,;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1300" y="800" width="230" height="150" as="geometry" /></mxCell>
<mxCell id="secC" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf3ec;strokeColor=#e3ac7c;verticalAlign=top;fontSize=1;" vertex="1" parent="1"><mxGeometry x="30" y="980" width="1700" height="1880" as="geometry" /></mxCell>
<mxCell id="labelC" value="C. THUẬT TOÁN SUY LUẬN RESNETv1-6 1D — LUỒNG CÓ NHÁNH" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;align=left;fontColor=#a9530f;" vertex="1" parent="1"><mxGeometry x="50" y="990" width="700" height="24" as="geometry" /></mxCell>
<mxCell id="subC" value="Xanh = Nhánh A (main path) · Cam = Nhánh B (shortcut/identity) · Vàng ⊕ = hợp nhánh · Xám = thân chung" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="1018" width="900" height="20" as="geometry" /></mxCell>
<mxCell id="raw" value="xraw — dữ liệu cảm biến thô&lt;br&gt;(128, 9)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="1070" width="260" height="50" as="geometry" /></mxCell>
<mxCell id="n0" value="&lt;b&gt;N0 · Chuẩn hoá Z-score&lt;/b&gt; (ngoài đồ thị Keras)&lt;br&gt;$$x^{n}_{t,c} = \dfrac{x^{raw}_{t,c}-\mu_c}{\sigma_c}$$&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;μ, σ fit trên tập train · (128,9) → (128,9)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1150" width="340" height="90" as="geometry" /></mxCell>
<mxCell id="b1label" value="BLOCK 1 — residual, đổi shape (128,9) → (64,32)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="280" y="1250" width="440" height="20" as="geometry" /></mxCell>
<mxCell id="n1" value="&lt;b&gt;N1 · block1_conv1&lt;/b&gt; — Conv1D K=3, same, bias&lt;br&gt;$$y_{t,c_o}=b_{c_o}+\sum_{k=0}^{K-1}\sum_{c_i=0}^{C_{in}-1} W_{k,c_i,c_o}\;\tilde{x}_{t+k-p,\,c_i}$$&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;K=3, p=1 · (128,9) → (128,32) · 896 tham số&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1280" width="340" height="100" as="geometry" /></mxCell>
<mxCell id="n2" value="&lt;b&gt;N2 · block1_relu1&lt;/b&gt; — ReLU&lt;br&gt;$$y_{t,c} = \max(0,\,x_{t,c})$$&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(128,32)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1400" width="340" height="70" as="geometry" /></mxCell>
<mxCell id="n3" value="&lt;b&gt;N3 · block1_conv2&lt;/b&gt; — Conv1D K=3, same, bias&lt;br&gt;$$y_{t,c_o}=b_{c_o}+\sum_{k=0}^{K-1}\sum_{c_i=0}^{C_{in}-1} W_{k,c_i,c_o}\;\tilde{x}_{t+k-p,\,c_i}$$&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;K=3, p=1 · (128,32) → (128,32) · 3.104 tham số&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1490" width="340" height="100" as="geometry" /></mxCell>
<mxCell id="n4" value="&lt;b&gt;N4 · block1_main_pool&lt;/b&gt; — MaxPool1D /2&lt;br&gt;$$y_{t,c} = \max\big(x_{2t,c},\,x_{2t+1,c}\big)$$&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(128,32) → (64,32)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1610" width="340" height="80" as="geometry" /></mxCell>
<mxCell id="n5" value="&lt;b&gt;N5 · block1_projection&lt;/b&gt; — Conv1D K=1 (≡ valid, p=0)&lt;br&gt;$$y_{t,c_o}=b_{c_o}+\sum_{c_i=0}^{C_{in}-1} W_{0,c_i,c_o}\;x_{t,c_i}$$&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;K=1, p=0 · (128,9) → (128,32) · 320 tham số · đổi 9→32 kênh&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="1280" width="340" height="100" as="geometry" /></mxCell>
<mxCell id="n6" value="&lt;b&gt;N6 · block1_shortcut_pool&lt;/b&gt; — MaxPool1D /2&lt;br&gt;$$y_{t,c} = \max\big(x_{2t,c},\,x_{2t+1,c}\big)$$&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(128,32) → (64,32) · khớp shape với nhánh A1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="1400" width="340" height="80" as="geometry" /></mxCell>
<mxCell id="merge1" value="N7 ⊕&lt;br&gt;$$F+S$$" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="1710" width="140" height="80" as="geometry" /></mxCell>
<mxCell id="n8" value="&lt;b&gt;N8 · block1_output&lt;/b&gt; — ReLU trên tổng hai nhánh&lt;br&gt;$$x^{1}_{t,c} = \max\big(0,\;F_{t,c}+S_{t,c}\big)$$&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;F = N4 (main) , S = N6 (shortcut) · ra (64,32)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="1830" width="340" height="90" as="geometry" /></mxCell>
<mxCell id="b2label" value="BLOCK 2 — residual, giữ nguyên shape (64,32) → (64,32)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="280" y="1940" width="440" height="20" as="geometry" /></mxCell>
<mxCell id="n9" value="&lt;b&gt;N9 · block2_conv1&lt;/b&gt; — Conv1D K=3, same, bias&lt;br&gt;$$y_{t,c_o}=b_{c_o}+\sum_{k=0}^{K-1}\sum_{c_i=0}^{C_{in}-1} W_{k,c_i,c_o}\;\tilde{x}_{t+k-p,\,c_i}$$&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;K=3, p=1 · (64,32) → (64,32) · 3.104 tham số&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1980" width="340" height="100" as="geometry" /></mxCell>
<mxCell id="n10" value="&lt;b&gt;N10 · block2_relu1&lt;/b&gt; — ReLU&lt;br&gt;$$y_{t,c} = \max(0,\,x_{t,c})$$&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(64,32)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2100" width="340" height="70" as="geometry" /></mxCell>
<mxCell id="n11" value="&lt;b&gt;N11 · block2_conv2&lt;/b&gt; — Conv1D K=3, same, bias&lt;br&gt;$$y_{t,c_o}=b_{c_o}+\sum_{k=0}^{K-1}\sum_{c_i=0}^{C_{in}-1} W_{k,c_i,c_o}\;\tilde{x}_{t+k-p,\,c_i}$$&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;K=3, p=1 · (64,32) → (64,32) · 3.104 tham số&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2190" width="340" height="100" as="geometry" /></mxCell>
<mxCell id="b2id" value="&lt;b&gt;Nhánh B2 · identity shortcut&lt;/b&gt;&lt;br&gt;$$S_{t,c} = x^{1}_{t,c}$$&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;không phép toán, không tham số · (64,32) · lý do: shape main/shortcut đã khớp sẵn&lt;/font&gt;" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="2060" width="340" height="90" as="geometry" /></mxCell>
<mxCell id="merge2" value="N12 ⊕&lt;br&gt;$$F+S$$" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="2320" width="140" height="80" as="geometry" /></mxCell>
<mxCell id="n13" value="&lt;b&gt;N13 · block2_output&lt;/b&gt; — ReLU trên tổng hai nhánh&lt;br&gt;$$x^{2}_{t,c} = \max\big(0,\;F_{t,c}+S_{t,c}\big)$$&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;F = N11 (main) , S = x1 (identity) · ra (64,32)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="2440" width="340" height="90" as="geometry" /></mxCell>
<mxCell id="headlabel" value="HEAD — phân loại" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="280" y="2545" width="440" height="20" as="geometry" /></mxCell>
<mxCell id="n14" value="&lt;b&gt;N14 · global_max_pool&lt;/b&gt; — GlobalMaxPooling1D&lt;br&gt;$$g_c = \max_{0 \le t &lt; L} x_{t,c}$$&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(64,32) → (32,) · lấy max theo trục thời gian&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="2575" width="340" height="90" as="geometry" /></mxCell>
<mxCell id="n15" value="&lt;b&gt;N15 · activity_logits&lt;/b&gt; — Dense, bias, KHÔNG activation&lt;br&gt;$$z_o = b_o + \sum_{i=0}^{D_{in}-1} g_i\,W_{i,o}$$&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(32,) → (6,) · 198 tham số · ra LOGITS THÔ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="2685" width="340" height="95" as="geometry" /></mxCell>
<mxCell id="argmax" value="&lt;b&gt;Dự đoán lớp&lt;/b&gt;&lt;br&gt;$$\hat{y} = \operatorname*{arg\,max}_{o}\; z_o$$&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;softmax CHƯA nằm trong model (chỉ demo) · lớp 0..5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="2800" width="340" height="80" as="geometry" /></mxCell>
<mxCell id="legend" value="&lt;b&gt;Chú giải &amp; định nghĩa phụ&lt;/b&gt;&lt;br&gt;🟦 Nhánh A — main path (có trọng số)&lt;br&gt;🟧 Nhánh B — shortcut (projection ở Block1, identity ở Block2)&lt;br&gt;🟡 ⊕ — điểm hợp nhánh (cộng phần tử)&lt;br&gt;⬜ Xám/xanh lá — thân chung, không rẽ nhánh&lt;br&gt;$$p=\left\lfloor K/2 \right\rfloor$$&lt;br&gt;$$\tilde{x}_{s,c}=\begin{cases}x_{s,c}, &amp; 0\le s&lt;L\\0, &amp; \text{khác}\end{cases}$$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="2685" width="250" height="220" as="geometry" /></mxCell>
